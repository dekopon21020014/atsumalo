# Environment variables for Atsumalo
# Copy this file to .env.local and adjust values to your environment.

# ── Firebase Admin SDK (server-side, secret) ──────────────────────────────
# Obtain from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private key as a single line, replacing literal newlines with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── Cron authentication ───────────────────────────────────────────────────
# Random secret shared between Vercel Cron and the cron API endpoints.
# Set the same value in Vercel Dashboard → Settings → Environment Variables.
CRON_SECRET=your-random-secret-here

# ── Firebase Client SDK (public, prefixed with NEXT_PUBLIC_) ─────────────
# Obtain from Firebase Console → Project Settings → Your apps → Web app
# These values are exposed to the browser and are NOT secret.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
